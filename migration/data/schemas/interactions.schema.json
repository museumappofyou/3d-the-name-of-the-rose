{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "schema_version",
  "id",
  "interactions"
 ],
 "properties": {
  "schema_version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1
  },
  "id": {
   "type": "string"
  },
  "interactions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "entity_id",
     "anchor_id",
     "radius",
     "kind",
     "label",
     "rules"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]*$"
     },
     "entity_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]*$"
     },
     "anchor_id": {
      "type": "string"
     },
     "radius": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 20
     },
     "kind": {
      "enum": [
       "pivot_portal",
       "person",
       "observe"
      ]
     },
     "label": {
      "type": "string"
     },
     "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "if",
        "do"
       ],
       "properties": {
        "if": {
         "type": "object"
        },
        "do": {
         "type": "array",
         "items": {
          "type": "object"
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
