[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/fallback_to_vulkan=false
rendering_device/fallback_to_d3d12=false
rendering_device/fallback_to_opengl3=false
renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.06, 1)
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/atlas_size=2048

[shader_globals]

snow_cover={
"type": "float",
"value": 0.42
}
ibl_share={
"type": "float",
"value": 0.6
}
wetness={
"type": "float",
"value": 0.15
}
ground_field={
"type": "sampler2D",
"value": ""
}
ground_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 1)
}
trodden_field={
"type": "sampler2D",
"value": ""
}
trodden_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 1)
}
