{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "schema_version",
  "id",
  "discoveries",
  "derived"
 ],
 "properties": {
  "schema_version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1
  },
  "id": {
   "type": "string"
  },
  "discoveries": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "title",
     "seen",
     "evidence"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]*$"
     },
     "title": {
      "type": "string"
     },
     "seen": {
      "type": "string"
     },
     "reading": {
      "type": "string"
     },
     "where": {
      "type": "string"
     },
     "place": {
      "type": "string"
     },
     "location_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "claim_id": {
         "type": "string",
         "pattern": "^claim_[0-9]{6}$"
        },
        "doc": {
         "type": "string"
        },
        "status": {
         "enum": [
          "EXPLICIT",
          "RECONSTRUCTION",
          "INFERRED"
         ]
        },
        "use": {
         "type": "string"
        }
       },
       "required": [
        "status"
       ]
      }
     }
    }
   }
  },
  "derived": {
   "type": "object",
   "additionalProperties": {
    "type": "object"
   }
  },
  "routes": {
   "type": "object"
  }
 }
}
