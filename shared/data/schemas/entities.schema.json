{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "schema_version",
  "id",
  "entities"
 ],
 "properties": {
  "schema_version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1
  },
  "id": {
   "type": "string"
  },
  "entities": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:._-]*$"
     },
     "kind": {
      "enum": [
       "person",
       "pivot_portal",
       "test_fixture"
      ]
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "claim_id": {
         "type": "string",
         "pattern": "^claim_[0-9]{6}$"
        },
        "doc": {
         "type": "string"
        },
        "status": {
         "enum": [
          "EXPLICIT",
          "RECONSTRUCTION",
          "INFERRED"
         ]
        },
        "use": {
         "type": "string"
        }
       },
       "required": [
        "status"
       ]
      }
     }
    }
   }
  }
 }
}
