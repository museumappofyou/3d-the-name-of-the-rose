{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "schema_version",
  "id",
  "streams",
  "office",
  "steps"
 ],
 "properties": {
  "schema_version": {
   "type": "integer",
   "minimum": 1,
   "maximum": 1
  },
  "id": {
   "type": "string"
  },
  "streams": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "source",
     "native",
     "credit"
    ],
    "properties": {
     "source": {
      "type": "string",
      "pattern": "^shared/assets/audio/[^/]+\\.mp3$"
     },
     "credit": {
      "type": "object",
      "required": [
       "licence"
      ]
     }
    }
   }
  },
  "office": {
   "type": "object",
   "required": [
    "chant_for",
    "source_emitter"
   ]
  },
  "steps": {
   "type": "object",
   "required": [
    "banks"
   ]
  }
 }
}
